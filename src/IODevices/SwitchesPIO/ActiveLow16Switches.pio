; 16 switches on IO_16_8_1, resetting GPIO 15-18 before every read.
;
; Inputs 13-16 (GPIO 15-18) are also the matrix column drivers: a high GPIO
; turns on a FET that pulls the connector low, and the level shifter feeds that
; back to the GPIO, so a released switch cannot settle high by itself. The
; reset pulse frees it, so it has to come before every read - not only after a
; report, which is all this program used to do.
;
; It used to look as if it did anyway. The CPU's baseline had bits set above
; the 16 pins, no read ever matched it, so the program reported on every pass
; and the reset ran each time. That kept inputs 13-16 working at the price of
; an endless stream of interrupts. Now the reset is part of every read, and
; the program only reports a change.
;
; The pulse and the read timing are the ones that work on the machines: low
; 2 cycles, high 6, low 2, release, read 3 cycles later, then read again until
; two reads agree.
.program active_low_16_switches_pio
    mov osr, ~null          ; matches no read, so the first one is reported

reset_stateful_pins:
    set pindirs, 0b1111     ; GPIO 15-18 to output
    set pins, 0 [1]         ; settle LOW
    set pins, 0b1111 [5]    ; HIGH
    set pins, 0 [1]         ; LOW again before releasing the inputs
    set pindirs, 0          ; back to input
    mov isr, null [1]       ; ISR is 0x0
    in pins, 16             ; read 16 switches to ISR

settle:
    mov x, isr [5]          ; X = this read, then a short delay for debouncing
    mov isr, null           ; ISR is 0x0
    in pins, 16             ; read again
    mov y, isr
    jmp x!=y settle         ; still moving: keep reading until two reads agree

    mov y, osr              ; compare with the state the CPU last accepted
    jmp x!=y new_stable_state

    set y, 31               ; nothing changed: wait about 2.5 us at 200 MHz,
idle:                       ; roughly what one report used to take, so the
    jmp y-- idle [15]       ; pins are driven no more often than before
    jmp reset_stateful_pins

new_stable_state:
    push                    ; push ISR to RX FIFO
    irq 1                   ; trigger interrupt 1 to notify the main CPU that switches changed
    pull                    ; pull the accepted state from TX FIFO to OSR
    jmp reset_stateful_pins
